/* ===== Reset ===== */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f7fb;
    color:#222;
}

/* ===== Header ===== */
header{
    background:#0066ff;
    color:#fff;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 20px;
    flex-wrap:wrap;
}

.logo h1{
    font-size:26px;
}

nav a{
    color:#fff;
    text-decoration:none;
    margin:0 10px;
    font-weight:bold;
}

nav a:hover{
    text-decoration:underline;
}

/* ===== Hero ===== */
.hero{
    text-align:center;
    padding:40px 20px;
}

.hero h2{
    font-size:34px;
    margin-bottom:10px;
}

.hero p{
    color:#555;
    margin-bottom:20px;
}

#search{
    width:90%;
    max-width:500px;
    padding:12px;
    border:1px solid #ccc;
    border-radius:8px;
    font-size:16px;
}

/* ===== App Cards ===== */
.apps{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:20px;
    padding:30px;
}

.card{
    background:#fff;
    width:280px;
    border-radius:12px;
    padding:20px;
    text-align:center;
    box-shadow:0 4px 12px rgba(0,0,0,.1);
    transition:.3s;
}

.card:hover{
    transform:translateY(-5px);
}

.card img{
    width:90px;
    height:90px;
    border-radius:20px;
    margin-bottom:15px;
}

.card h3{
    margin-bottom:8px;
}

.card p{
    color:#666;
    margin-bottom:15px;
}

.card button{
    background:#0066ff;
    color:#fff;
    border:none;
    padding:12px 20px;
    border-radius:8px;
    cursor:pointer;
    font-size:16px;
}

.card button:hover{
    background:#004dcc;
}

/* ===== Footer ===== */
footer{
    background:#111;
    color:#fff;
    text-align:center;
    padding:20px;
    margin-top:40px;
}

/* ===== Responsive ===== */
@media(max-width:768px){

header{
    flex-direction:column;
}

nav{
    margin-top:10px;
}

.hero h2{
    font-size:28px;
}

.card{
    width:90%;
}

}
